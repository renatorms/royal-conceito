SECRET_KEY=changeme
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
# Só usado quando DEBUG=False (em dev, todas as origens são liberadas)
CORS_ALLOWED_ORIGINS=https://meufrontend.com
# Origens confiáveis para validação de CSRF (necessário mesmo em dev, pois o
# frontend Vite roda em porta diferente do backend)
CSRF_TRUSTED_ORIGINS=http://localhost:5173
# Token da API da SuperFrete (sandbox em dev, produção em prod — gerado em
# https://sandbox.superfrete.com/#/integrations ou o equivalente de produção)
SUPERFRETE_TOKEN=changeme
# CEP de origem da loja, sem hífen (formato exigido pela API) — mesmo valor
# em qualquer ambiente, já que é o endereço físico real da loja, não uma
# credencial por ambiente
SUPERFRETE_CEP_ORIGEM=72017212
