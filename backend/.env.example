SECRET_KEY=changeme
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
# Só usado quando DEBUG=False (em dev, todas as origens são liberadas)
CORS_ALLOWED_ORIGINS=https://meufrontend.com
# Origens confiáveis para validação de CSRF (necessário mesmo em dev, pois o
# frontend Vite roda em porta diferente do backend)
CSRF_TRUSTED_ORIGINS=http://localhost:5173
# Token da API da SuperFrete (sandbox em dev, produção em prod — gerado em
# https://sandbox.superfrete.com/#/integrations ou o equivalente de produção)
SUPERFRETE_TOKEN=changeme
# CEP de origem da loja, sem hífen (formato exigido pela API) — mesmo valor
# em qualquer ambiente, já que é o endereço físico real da loja, não uma
# credencial por ambiente
SUPERFRETE_CEP_ORIGEM=72017212
# Handle (tag pública, sem "$") da conta InfinitePay que recebe os
# pagamentos — gerado em https://recebimentos.infinitepay.io ou o app
# InfinitePay, na seção de configuração da conta. Valor abaixo é um
# placeholder; hoje em dev usa a conta pessoal do desenvolvedor, precisa
# trocar pelo handle da conta do cliente antes de produção.
INFINITEPAY_HANDLE=changeme
# URL pública do frontend — usada para montar o redirect_url (InfinitePay
# manda o cliente de volta pra cá após o pagamento)
FRONTEND_URL=http://localhost:5173
# URL pública do backend — usada para montar o webhook_url (InfinitePay
# chama esse endereço pra notificar pagamento confirmado). Em dev, localhost
# não é alcançável pela InfinitePay de fora — precisa de um túnel (ex:
# ngrok) apontado pra cá se for testar o webhook de ponta a ponta.
BACKEND_URL=http://localhost:8000
